# ==============================================================================
# FloodLens AI — Nepal Terai Flood Intelligence System
# Configuration & Satellite Provider Environment Variables
# ==============================================================================

# Satellite Acquisition Provider
# Options:
#   auto         - Deterministically search Element84 AWS STAC first; use Google Earth Engine if authenticated
#   stac         - Public STAC Catalog only (Element84 AWS STAC / Microsoft Planetary Computer)
#   earth_engine - Google Earth Engine API (requires active project credentials)
SATELLITE_PROVIDER=auto

# Public STAC API Endpoint
# Default: Element84 Earth Search STAC v1 (free, zero-authentication COGs hosted on AWS S3)
STAC_API_ENDPOINT=https://earth-search.aws.element84.com/v1/search

# Microsoft Planetary Computer API Key (Optional)
# Leave blank unless accessing authenticated PC collections
PC_API_KEY=

# Google Earth Engine Configuration (Optional)
# To use Earth Engine:
#   1. Install: pip install earthengine-api
#   2. Run: earthengine authenticate
#   3. Set your Google Cloud Project ID below
GEE_PROJECT_ID=

# MapTiler / Basemap API Key (Optional)
# The application includes 3 built-in zero-key-required basemaps (Carto Dark, Esri World Imagery, OpenStreetMap).
# Supplying a MapTiler key enables additional high-resolution vector terrain styles.
VITE_MAPTILER_KEY=

# Server Ports (Defaults)
PORT=8000
HOST=127.0.0.1
